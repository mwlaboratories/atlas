(version 1)
# Copper to board edge: 0.3 mm everywhere (the board-setup minimum is 0 so this rule can make one exception) ...
(rule "copper_edge_default"
  (constraint edge_clearance (min 0.3mm)))
# ... except the TOTEM-style XIAO windows of both halves (U1 left, U101 right)
(rule "xiao_window_pads"
  (condition "((A.memberOfFootprint('U1') || A.memberOfFootprint('U101')) && A.Pad_Type == 'Through-hole') || ((B.memberOfFootprint('U1') || B.memberOfFootprint('U101')) && B.Pad_Type == 'Through-hole')")
  (constraint edge_clearance (min 0mm))
  (severity ignore))
