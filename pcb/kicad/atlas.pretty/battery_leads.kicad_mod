(footprint "battery_leads"
    (version 20240108)
    (generator "atlas")
    (layer "F.Cu")
    (descr "Solder pads for hand-soldered LiPo battery leads (no connector — saves height). Pad 1 = BAT+, Pad 2 = BAT-.")
    (tags "battery lipo solder pads bat")
    (property "Value" "BATT" (at 0 4 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (property "Reference" "BT"
      (at 0 -4 0)
      (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (attr smd)
    (pad "1" smd roundrect (at -2.5 0) (size 1.8 3) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
    (pad "2" smd roundrect (at 2.5 0) (size 1.8 3) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
    (fp_text user "+" (at -2.5 -2.7 0) (layer "F.SilkS") (effects (font (size 1.4 1.4) (thickness 0.25))))
    (fp_text user "-" (at 2.5 -2.7 0) (layer "F.SilkS") (effects (font (size 1.4 1.4) (thickness 0.25))))
    (fp_line (start -4.2 -2.3) (end 4.2 -2.3) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
    (fp_line (start 4.2 -2.3) (end 4.2 2.3) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
    (fp_line (start 4.2 2.3) (end -4.2 2.3) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
    (fp_line (start -4.2 2.3) (end -4.2 -2.3) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  )
