/*
 * Phase 1 ADS1220 bench test — overlay for XIAO nRF52840 Plus.
 *
 * BENCH ADJUSTMENT: this XIAO has a broken MISO1 (D18 / P1.05) tab.
 * MISO is rerouted to D13 (I2S_WS / P1.01). The PCB design in
 * tools/keyboard.yaml keeps D18 as the canonical MISO assignment —
 * this override is bench-only.
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 3)>,    /* D17 / P1.03 */
				<NRF_PSEL(SPIM_MOSI, 1, 7)>,    /* D19 / P1.07 */
				<NRF_PSEL(SPIM_MISO, 1, 1)>;    /* D13 / P1.01  ← BENCH override */
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 7)>,
				<NRF_PSEL(SPIM_MISO, 1, 1)>;
			low-power-enable;
		};
	};
};

&spi1 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;          /* D11 / P0.15 */

	ads1220: ads1220@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
		status = "okay";
	};
};

/ {
	inputs {
		compatible = "gpio-keys";
		drdy: drdy {
			gpios = <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* D12 / P0.19 */
			label = "ADS1220 DRDY";
		};
	};
};

/* Route console to USB CDC ACM. */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};
