/*
 * Atlas split, 17 keys per half, charlieplexed on 5 lines + interrupt (zmk,kscan-gpio-charlieplex).
 * Generated from the routed KiCad boards (pcb/atlas-left.kicad_pcb, pcb/atlas-right.kicad_pcb).
 * Key wiring: line Pi -> switch -> 1N4148W -> line Cj, so RC(i, j) = drive i, sense j.
 * Every Cj also goes through a BAW56 to its own GPIO (blocks back-feed) and to INT (wake-up).
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <10>;   /* right half: col-offset 5 */
        map = <
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(0,4)   RC(0,9) RC(4,8) RC(4,7) RC(4,6) RC(4,5)
            RC(3,0) RC(3,1) RC(3,2) RC(0,3) RC(3,4)   RC(3,9) RC(0,8) RC(3,7) RC(3,6) RC(3,5)
            RC(2,0) RC(2,1) RC(0,2) RC(2,3) RC(2,4)   RC(2,9) RC(2,8) RC(0,7) RC(2,6) RC(2,5)
                                                    RC(1,3) RC(1,4)   RC(1,9) RC(1,8)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;
        /* eager press (registers on first contact), 5 ms release debounce, 1 ms scan while keys are held */
        debounce-press-ms = <1>;
        debounce-release-ms = <5>;
        debounce-scan-period-ms = <1>;
    };
};
