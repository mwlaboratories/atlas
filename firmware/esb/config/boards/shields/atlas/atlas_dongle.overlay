/*
 * atlas dongle: keyless XIAO on USB, the ESB central. It has no matrix of its
 * own (mock kscan) but needs the keyboard's transform so key positions match.
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;
    };

    /* ESB split transport address config (same on dongle and halves) */
    esb_split {
        compatible = "zmk,esb-split";
        base-addr-0 = <0xE7 0xE7 0xE7 0xE7>;
        base-addr-1 = <0xC2 0xC2 0xC2 0xC2>;
        addr-prefix = <0xE7 0xC2 0xC3 0xC4 0xC5 0xC6 0xC7 0xC8>;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <5>;
        map = <
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(0,4)   RC(0,9) RC(4,8) RC(4,7) RC(4,6) RC(4,5)
            RC(3,0) RC(3,1) RC(3,2) RC(0,3) RC(3,4)   RC(3,9) RC(0,8) RC(3,7) RC(3,6) RC(3,5)
            RC(2,0) RC(2,1) RC(0,2) RC(2,3) RC(2,4)   RC(2,9) RC(2,8) RC(0,7) RC(2,6) RC(2,5)
                                                    RC(1,3) RC(1,4)   RC(1,9) RC(1,8)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
    };
};
