/*
 * Atlas split, 17 keys per half: 4x5 diode matrix (col2row) on a XIAO nRF52840 Plus.
 * Generated from the routed KiCad boards (pcb/atlas-*.kicad_pcb).
 * Key wiring: COLc -> switch -> 1N4148W -> ROWr; rows 0-2 = R0-R2, row 3 = thumbs (T0 c3, T1 c4).
 */
#include <dt-bindings/zmk/matrix_transform.h>

/*
 * The XIAO's default buses sit on pins this board uses for something else
 * (SPI D8-D10: right-hand columns; I2C D4/D5: columns left, ADS1220 DOUT +
 * thumb row right; UART D6/D7: ADS1220 DRDY/CS left, rows right). Off, so
 * that switching on a bus driver can't hand them those pins. The ADS1220
 * build turns SPI back on with its own pins (ads1220.dtsi).
 */
&xiao_spi { status = "disabled"; };
&xiao_i2c { status = "disabled"; };
&xiao_serial { status = "disabled"; };

/ {
    /* ESB split transport address config (same on dongle and halves) */
    esb_split {
        compatible = "zmk,esb-split";
        base-addr-0 = <0xE7 0xE7 0xE7 0xE7>;
        base-addr-1 = <0xC2 0xC2 0xC2 0xC2>;
        addr-prefix = <0xE7 0xC2 0xC3 0xC4 0xC5 0xC6 0xC7 0xC8>;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;   /* right half: col-offset 5 */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                                    RC(3,3) RC(3,4)   RC(3,9) RC(3,8)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        /* eager press (registers on first contact), 5 ms release debounce, 1 ms scan while keys are held */
        debounce-press-ms = <1>;
        debounce-release-ms = <5>;
        debounce-scan-period-ms = <1>;
    };
};
