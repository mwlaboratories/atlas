# Private / local workspace — not part of the published board.
# The public-facing artifact is the hand-laid KiCad board under pcb/.
tools/
node_modules/

# per-user devenv state
.devenv/
.direnv/
devenv.local.nix

# Local Claude harness
.claude/
CLAUDE.md

# OS / editor
.DS_Store
*.swp
*~

# KiCad cruft (user-local, generated, or temp)
_autosave-*.kicad_pcb
~*.lck
*.kicad_prl
*.bak
fp-info-cache
*-drc.rpt

# Fabrication-Toolkit output
/pcb/kicad/production/
/pcb/kicad/*.zip

# Generated 3D / fab outputs — re-generate via scripts when needed.
/pcb/kicad/*.step
/pcb/kicad/*.STEP
/keyboard-plate.stl
*.dxf
*.gbr
*.drl
gerbers/

# nix build output
result

# west-managed workspace (generated by `just init` / `west update`) —
# only zmk-workspace-ble/config and flake.* are tracked.
zmk-workspace-ble/.build/
zmk-workspace-ble/.west/
zmk-workspace-ble/firmware/
zmk-workspace-ble/modules/
zmk-workspace-ble/optional/
zmk-workspace-ble/zephyr/
zmk-workspace-ble/zmk/
zmk-workspace-ble/kb_zmk_ps2_mouse_trackpoint_driver/

# keymap-drawer intermediate (SVG lands in images/keymap.svg)
nix/keymap.yaml
